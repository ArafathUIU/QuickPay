<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary filled button -->
    <style name="QuickPay.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xxl</item>
        <item name="android:paddingEnd">@dimen/spacing_xxl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Outlined button -->
    <style name="QuickPay.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text button -->
    <style name="QuickPay.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text input -->
    <style name="QuickPay.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="cornerRadius">@dimen/corner_small</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Elevated card -->
    <style name="QuickPay.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_large</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Section title -->
    <style name="QuickPay.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- Body text -->
    <style name="QuickPay.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Status pill for transaction states -->
    <style name="QuickPay.StatusPill" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/success_light</item>
        <item name="android:textColor">@color/success</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>